# PowerShell: set these with $env:NAME = "value" before starting the app.
# This file is a reference; it is not automatically loaded.
TRONCLASS_DB_PATH=sample_data/course.db
TRONCLASS_STUDENT_ID=S11200001
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Set the exact name shown by `ollama list`; no model is downloaded automatically.
OLLAMA_MODEL=
# Optional bearer key for a protected remote Ollama gateway; never commit a real key.
OLLAMA_API_KEY=
# Alternative to Ollama: use LLM_PROVIDER=cloudflare and set these values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=anthropic/claude-haiku-4.5
CLOUDFLARE_GATEWAY_ID=
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
# Frozen scenario time, after the latest announcement in the bundled dataset.
REFERENCE_TIME=2026-10-31T09:00:00+08:00

# Server only; Start-SharedOllamaApi.ps1 sets these for its child process.
# TRONCLASS_API_RPM=30
# TRONCLASS_API_KEY_FILE=<private key file outside the repository>
